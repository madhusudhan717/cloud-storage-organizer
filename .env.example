# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="CHANGE_ME_LOCAL_DEV_SECRET_KEY"
S3_BUCKET_NAME="cloud-organizer-private"
S3_PUBLIC_DEMO_BUCKET="cloud-organizer-public-sandbox"
S3_REGION="us-east-1"
DEFAULT_PRESIGNED_EXPIRATION="300"

